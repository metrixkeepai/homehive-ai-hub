# Server-only canonical origin for this deployment. Replace for isolated staging.
APP_ORIGIN=https://YOUR-STAGING-DOMAIN
VITE_APP_ORIGIN=https://YOUR-STAGING-DOMAIN
# Optional exact comma-separated return origins; no wildcards. Leave empty by default.
APP_ADDITIONAL_RETURN_ORIGINS=
# Configure provider credentials directly in the target secret store.

# Separate Supabase projects for staging and production. Never use production data in staging.
APP_ENV=staging
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Restricted application key stored only on the server.
OPENAI_API_KEY=
STRIPE_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_PAYMENTS_CLIENT_TOKEN=
# Set after TLS verification; do not infer this from a forwarded header.
HTTPS_VERIFIED=false
PORT=3000
# Drizzle administrative migration connection, never a public browser variable.
DATABASE_MIGRATION_URL=
